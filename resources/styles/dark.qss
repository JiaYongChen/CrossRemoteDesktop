/* ═══════════════════════════════════════════════════════════
 * CrossRemoteDesktop — 深色主题 QSS
 *
 * 架构：三段式分层
 *   第一层：全局基础（系统级控件）
 *   第二层：类型默认样式（无父选择器限定）
 *   第三层：区域样式覆盖（按 .ui 文件分组，父→子→孙）
 * ═══════════════════════════════════════════════════════════
 *
 *
 *  设计令牌 / Design Tokens
 * ═══════════════════════════════════════════════════════════
 *
 *  ① 基础色板
 *    --color-bg-page:          #1E1E1E    (QMainWindow)
 *    --color-bg-card:          #262626    (卡片/GroupBox)
 *    --color-bg-elevated:      #272727    (输入框/菜单)
 *    --color-bg-nav:           #1A1A1A    (左侧导航栏)
 *    --color-bg-nav-btn:       #131313    (导航按钮静态)
 *    --color-bg-statusbar:     #121212    (状态栏)
 *    --color-bg-sidebar:       #121212    (设置侧栏)
 *    --color-bg-content:       #252525    (设置内容区)
 *    --color-bg-btnbar:        #1E1E1E    (设置按钮区)
 *    --color-bg-disabled:      #202020    (禁用态)
 *    --color-bg-tooltip:       #333333    (工具提示)
 *    --color-bg-dropdown:      #2D2D2D    (下拉列表)
 *    --color-bg-hamburger:     #333333    (汉堡菜单按钮)
 *
 *  ② 文字色
 *    --color-text-primary:     #E0E0E0    (正文)
 *    --color-text-secondary:   #AAAAAA    (标签/辅助)
 *    --color-text-muted:       #666666    (空状态/占位)
 *    --color-text-status:      #999999    (状态栏)
 *    --color-text-btn-secondary: #CCCCCC  (次要按钮文字)
 *    --color-text-on-accent:   #FFFFFF    (强调色上的文字)
 *
 *  ③ 强调色
 *    --color-accent:           #4A90D9    (默认)
 *    --color-accent-hover:     #5AA0E9    (悬停)
 *    --color-accent-pressed:   #3A80C9    (按下)
 *
 *  ④ 边框与分隔
 *    --color-border-default:   #444444    (输入框/菜单边框)
 *    --color-border-strong:    #555555    (SpinBox/ComboBox 边框)
 *    --color-border-light:     #3A3A3A    (卡片/GroupBox 边框)
 *    --color-border-subtle:    #2C2C2C    (状态栏顶部分隔)
 *    --color-border-sidebar:   #333333    (侧边栏分隔)
 *    --color-separator:        #3A3A3A    (侧边栏分隔线)
 *
 *  ⑤ 语义色
 *    --color-danger-hover:     #E05555    (退出按钮悬停)
 *
 *  ⑥ 悬停/按下态（控件通用）
 *    --color-hover-light:      #353535    (浅悬停)
 *    --color-hover-medium:     #404040    (中悬停)
 *    --color-hover-nav:        #2E2E2E    (导航按钮悬停)
 *    --color-pressed:          #4C4C4C    (按下)
 *    --color-pressed-nav:      #3A3A3A    (导航按钮按下)
 *
 *  ⑦ 圆角
 *    --radius-sm:              4px
 *    --radius-md:              6px
 *    --radius-lg:              8px
 *
 *  ⑧ 间距
 *    --spacing-xs:             4px
 *    --spacing-sm:             8px
 *    --spacing-md:             12px
 *    --spacing-input-px:       14px
 *    --spacing-input-py:       8px
 *    --spacing-btn-px:         20px
 *    --spacing-btn-py:         8px
 *
 *  ⑨ 字体
 *    --font-size-sm:           12px
 *    --font-size-md:           13px
 *    --font-size-lg:           14px
 *    --font-size-xl:           20px
 *    --font-weight-normal:     400
 *    --font-weight-bold:       600
 * ═══════════════════════════════════════════════════════════ */

/* ═══════════════════════ 第一层：全局基础 ═══════════════════════ */

QMainWindow {
    background-color: #FF0000;               /* token: --color-bg-page */
    color: #E0E0E0;                          /* token: --color-text-primary */
}

QDialog {
    background-color: #1E1E1E;               /* token: --color-bg-page */
    color: #E0E0E0;                          /* token: --color-text-primary */
}

/* ----- 工具提示 ----- */
QToolTip {
    background-color: #333333;               /* token: --color-bg-tooltip */
    color: #E0E0E0;                          /* token: --color-text-primary */
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 4px 8px;                        /* token: --spacing-xs / --spacing-sm */
    font-size: 12px;                         /* token: --font-size-sm */
}

/* ----- 菜单 ----- */
QMenu {
    background-color: #272727;               /* token: --color-bg-elevated */
    border: 1px solid #444444;               /* token: --color-border-default */
    border-radius: 6px;                      /* token: --radius-md */
    padding: 4px 0;
    color: #E0E0E0;                          /* token: --color-text-primary */
}
QMenu::item {
    padding: 6px 24px;
}
QMenu::item:selected {
    background-color: #4A90D9;               /* token: --color-accent */
}
QMenu::separator {
    height: 1px;
    background: #3A3A3A;                     /* token: --color-border-light */
    margin: 4px 12px;
}

/* ----- 状态栏 ----- */
QStatusBar {
    background-color: #121212;               /* token: --color-bg-statusbar */
    color: #999999;                          /* token: --color-text-status */
    border-top: 1px solid #2C2C2C;           /* token: --color-border-subtle */
}
QStatusBar QLabel {
    color: #999999;                          /* token: --color-text-status */
    padding: 2px 8px;
    background: transparent;
}

/* ----- 全局滚动条（主窗口隐藏） ----- */
QScrollBar:vertical {
    width: 0px;
    background: transparent;
}
QScrollBar:horizontal {
    height: 0px;
    background: transparent;
}

/* ----- QScrollArea ----- */
QScrollArea {
    background: transparent;
    border: none;
}

/* ----- 文本选中色 ----- */
* {
    selection-background-color: #4A90D9;     /* token: --color-accent */
}

/* ═══════════════════════ 第二层：类型默认样式 ═══════════════════════ */

/* ----- QLabel ----- */
QLabel {
    color: #E0E0E0;                          /* token: --color-text-primary */
    background: transparent;
}

/* ----- QToolButton ----- */
QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 4px;                            /* token: --spacing-xs */
}
QToolButton:hover {
    background-color: #353535;               /* token: --color-hover-light */
}
QToolButton:pressed {
    background-color: #3C3C3C;               /* hover darken */
}

/* ----- QLineEdit ----- */
QLineEdit {
    background-color: #272727;               /* token: --color-bg-elevated */
    color: #E0E0E0;                          /* token: --color-text-primary */
    border: 1px solid #444444;               /* token: --color-border-default */
    border-radius: 6px;                      /* token: --radius-md */
    padding: 8px 14px;                       /* token: --spacing-input-py / --spacing-input-px */
    selection-background-color: #4A90D9;     /* token: --color-accent */
}
QLineEdit:focus {
    border-color: #4A90D9;                   /* token: --color-accent */
}

/* ----- QComboBox ----- */
QComboBox {
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 5px 10px;
    background-color: #272727;               /* token: --color-bg-elevated */
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-size: 13px;                         /* token: --font-size-md */
}
QComboBox:hover {
    border-color: #777777;               /* hover border */
}
QComboBox:focus {
    border-color: #4A90D9;                   /* token: --color-accent */
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    image: url(:/icons/dropdown-arrow.svg);
    width: 12px;
    height: 12px;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    background-color: #2D2D2D;               /* token: --color-bg-dropdown */
    selection-background-color: rgba(74, 144, 217, 0.20);    /* token: --color-accent (20% alpha) */
    selection-color: #E0E0E0;                /* token: --color-text-primary */
    outline: none;
}

/* ----- QSpinBox ----- */
QSpinBox {
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 12px;
    background-color: #272727;               /* token: --color-bg-elevated */
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-size: 13px;                         /* token: --font-size-md */
}
QSpinBox:hover {
    border-color: #777777;               /* hover border */
}
QSpinBox:focus {
    border-color: #4A90D9;                   /* token: --color-accent */
}
QSpinBox:disabled {
    background-color: #202020;               /* token: --color-bg-disabled */
    color: #666666;                          /* token: --color-text-muted */
    border-color: #3A3A3A;                   /* token: --color-border-light */
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #555555;          /* token: --color-border-strong */
    border-bottom: 1px solid #555555;          /* token: --color-border-strong */
    border-top-right-radius: 4px;
}
QSpinBox::up-button:hover { background-color: #3A3A3A; }                                       /* token: --color-border-light */
QSpinBox::up-arrow {
    image: url(:/icons/spin-up.svg);
    width: 8px;
    height: 8px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #555555;          /* token: --color-border-strong */
    border-bottom-right-radius: 4px;
}
QSpinBox::down-button:hover { background-color: #3A3A3A; }                                       /* token: --color-border-light */
QSpinBox::down-arrow {
    image: url(:/icons/spin-down.svg);
    width: 8px;
    height: 8px;
}

/* ----- QPushButton ----- */
QPushButton {
    background-color: #4A90D9;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 20px;                       /* token: --spacing-btn-py / --spacing-btn-px */
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 500;
    min-width: 90px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #5AA0E9;               /* token: --color-accent-hover */
}
QPushButton:pressed {
    background-color: #3A80C9;               /* token: --color-accent-pressed */
}

/* ----- QDialogButtonBox ----- */
QDialogButtonBox QPushButton {
    background-color: #4A90D9;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 6px 18px;
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 500;
    min-width: 90px;
    min-height: 28px;
}
QDialogButtonBox QPushButton:hover {
    background-color: #5AA0E9;               /* token: --color-accent-hover */
}
QDialogButtonBox QPushButton:pressed {
    background-color: #3A80C9;               /* token: --color-accent-pressed */
}

/* ----- QCheckBox ----- */
QCheckBox {
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-size: 13px;                         /* token: --font-size-md */
    spacing: 8px;                            /* token: --spacing-sm */
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background-color: #2D2D2D;               /* token: --color-bg-dropdown */
    border: 2px solid #555555;               /* token: --color-border-strong */
}
QCheckBox::indicator:checked {
    background-color: #4A90D9;               /* token: --color-accent */
    border-color: #4A90D9;
}
QCheckBox::indicator:hover {
    border-color: #777777;
}
QCheckBox::indicator:checked:hover {
    background-color: #5AA0E9;               /* token: --color-accent-hover */
    border-color: #5AA0E9;
}

/* ----- QGroupBox ----- */
QGroupBox {
    background-color: #262626;               /* token: --color-bg-card */
    border: 1px solid #3A3A3A;               /* token: --color-border-light */
    border-radius: 8px;                      /* token: --radius-lg */
    margin-top: 8px;
    padding: 18px 12px 12px 12px;
    font-weight: 600;                        /* token: --font-weight-bold */
    font-size: 13px;                         /* token: --font-size-md */
    color: #E0E0E0;                          /* token: --color-text-primary */
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #E0E0E0;                          /* token: --color-text-primary */
}

/* ----- QTabWidget / QTabBar ----- */
QTabWidget::pane {
    background-color: #272727;               /* token: --color-bg-elevated */
    border: none;
    border-top: 1px solid #3A3A3A;           /* token: --color-border-light */
    top: -1px;
    padding: 6px 28px;
}
QTabBar::tab {
    background-color: transparent;
    color: #999999;                          /* token: --color-text-status */
    padding: 10px 20px;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 400;                        /* token: --font-weight-normal */
}
QTabBar::tab:selected {
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-weight: 600;                        /* token: --font-weight-bold */
    border-bottom: 3px solid #4A90D9;        /* token: --color-accent */
}
QTabBar::tab:hover:!selected {
    color: #CCCCCC;
}

/* ----- QListWidget ----- */
QListWidget {
    background-color: #121212;               /* token: --color-bg-sidebar */
    border: none;
    outline: none;
    font-size: 13px;                         /* token: --font-size-md */
    padding: 6px 4px;
}
QListWidget::item {
    padding: 9px 12px;
    margin: 1px 4px;
    border-radius: 6px;                      /* token: --radius-md */
    border-left: 3px solid transparent;
    color: #AAAAAA;                          /* token: --color-text-secondary */
    font-weight: 400;                        /* token: --font-weight-normal */
}
QListWidget::item:selected {
    background-color: rgba(255, 255, 255, 0.06);
    border-left: 3px solid #4A90D9;          /* token: --color-accent */
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-weight: 600;                        /* token: --font-weight-bold */
}
QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.03);
}

/* ----- QSlider ----- */
QSlider::groove:horizontal {
    background-color: #3A3A3A;               /* token: --color-border-light */
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background-color: #4A90D9;               /* token: --color-accent */
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #1E1E1E;               /* token: --color-bg-page */
    border: 2px solid #4A90D9;               /* token: --color-accent */
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background-color: #2D2D2D;               /* token: --color-bg-dropdown */
    border-color: #5AA0E9;                   /* token: --color-accent-hover */
}

/* ----- QTextEdit ----- */
QTextEdit {
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 12px;
    background-color: #2D2D2D;               /* token: --color-bg-dropdown */
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-size: 12px;                         /* token: --font-size-sm */
}
QTextEdit:focus {
    border-color: #4A90D9;                   /* token: --color-accent */
}

/* ----- 对话框内滚动条（与主窗口隐藏滚动条区分） ----- */
QDialog QScrollBar:vertical {
    width: 6px;
    background-color: transparent;
    margin: 0;
}
QDialog QScrollBar::handle:vertical {
    background-color: #555555;               /* token: --color-border-strong */
    border-radius: 3px;
    min-height: 30px;
}
QDialog QScrollBar::handle:vertical:hover {
    background-color: #777777;
}
QDialog QScrollBar::add-line:vertical,
QDialog QScrollBar::sub-line:vertical {
    height: 0px;
}
QDialog QScrollBar::add-page:vertical,
QDialog QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* ═══════════════════════ 第三层：区域样式覆盖 ═══════════════════════ */

/* ── [mainwindow.ui] 左侧导航栏 ────────────────────────────────
 * Widget 树（HamburgerMenu.ui）:
 *   QWidget#HamburgerMenu
 *     ├── QToolButton#hamburgerButton
 *     ├── QFrame#separator
 *     ├── QWidget#menuContainer
 *     │     ├── QToolButton#newConnectionItem  (objectName: hamburgerItem)
 *     │     ├── QToolButton#settingsItem       (objectName: hamburgerItem)
 *     │     ├── QToolButton#aboutItem          (objectName: hamburgerItem)
 *     │     └── QSpacer#menuStretch
 *     ├── QSpacer#mainStretch
 *     └── QToolButton#themeButton
 * ─────────────────────────────────────────────────────────────── */
#hamburgerMenu {
    background-color: #1A1A1A;               /* token: --color-bg-nav */
}

#hamburgerMenu > QToolButton {
    border: none;
    border-radius: 8px;                      /* token: --radius-lg */
    padding: 4px;                            /* token: --spacing-xs */
}
#hamburgerMenu > QToolButton:hover {
    background-color: #2E2E2E;               /* token: --color-hover-nav */
}
#hamburgerMenu > QToolButton:pressed {
    background-color: #3A3A3A;               /* token: --color-pressed-nav */
}

#hamburgerItem {
    background-color: #333333;               /* token: --color-bg-hamburger */
    border: none;
    border-radius: 8px;                      /* token: --radius-lg */
    padding: 8px;                            /* token: --spacing-sm */
}
#hamburgerItem:hover {
    background-color: #3C3C3C;               /* hover darken */
}

/* ── [mainwindow.ui] 品牌区 ──
 * Widget 树:
 *   QWidget#headerArea
 *     └── QLabel#logoLabel
 *     └── QLabel#titleLabel
 * ─────────────────────────────────────────────────────────────── */
#headerArea {
    background-color: transparent;
}

#titleLabel {
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-size: 20px;                         /* token: --font-size-xl */
    font-weight: bold;
    background: transparent;
}

/* ── [mainwindow.ui] ConnectionPanel 容器 ── */
#connectionPanel {
    background-color: #1E1E1E;               /* token: --color-bg-page */
}

/* ── [mainwindow.ui] 连接卡片区域 ──
 * Widget 树（ConnectionPanel 内部）:
 *   QFrame#connectionCard
 *     ├── QLabel#cardHostname
 *     ├── QLabel#cardLabel
 *     └── QToolButton (操作按钮)
 * ─────────────────────────────────────────────────────────────── */
#connectionPanel > QScrollArea {
    background-color: transparent;
}

#connectionCard {
    background-color: #262626;               /* token: --color-bg-card */
    border: 1px solid #3A3A3A;               /* token: --color-border-light */
    border-radius: 8px;                      /* token: --radius-lg */
}

#connectionCard QToolButton {
    background-color: #353535;               /* token: --color-hover-light */
    border: none;
    border-radius: 6px;                      /* token: --radius-md */
    padding: 4px;                            /* token: --spacing-xs */
}
#connectionCard QToolButton:hover {
    background-color: #404040;               /* token: --color-hover-medium */
}
#connectionCard QToolButton:pressed {
    background-color: #4C4C4C;               /* token: --color-pressed */
}

#cardHostname {
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-size: 14px;                         /* token: --font-size-lg */
    font-weight: bold;
    background: transparent;
}

#cardLabel {
    color: #AAAAAA;                          /* token: --color-text-secondary */
    font-size: 12px;                         /* token: --font-size-sm */
    background: transparent;
}

/* ── [mainwindow.ui] 搜索框 ── */
#searchBox {
    background-color: #272727;               /* token: --color-bg-elevated */
    color: #E0E0E0;                          /* token: --color-text-primary */
    border: 1px solid #444444;               /* token: --color-border-default */
    border-radius: 8px;                      /* token: --radius-lg */
    padding: 10px 16px;
    font-size: 14px;                         /* token: --font-size-lg */
}
#searchBox:focus {
    border-color: #4A90D9;                   /* token: --color-accent */
}

/* ── [mainwindow.ui] 空状态 ── */
#emptyStateLabel {
    color: #666666;                          /* token: --color-text-muted */
    font-size: 13px;                         /* token: --font-size-md */
    background: transparent;
}

/* ── [ConnectionDialog.ui] 对话框容器 ── */
#ConnectionDialog {
    background-color: #1E1E1E;               /* token: --color-bg-page */
}

#tabContainer {
    background-color: transparent;
}

/* QStackedWidget 本身不绘制背景，此规则仅为文档说明 */
QStackedWidget#settingsStackedWidget {
    background-color: transparent;
}

#connectionTab,
#optionsTab,
#advancedTab {
    background-color: transparent;
}

/* ── [settingsdialog.ui] 设置对话框 ──
 * Widget 树:
 *   QDialog#SettingsDialog
 *     └── QWidget#contentWidget
 *           ├── QWidget#sidebarWidget
 *           │     └── QListWidget#categoryListWidget
 *           ├── QWidget#mainContentWidget
 *           │     └── QStackedWidget#settingsStackedWidget
 *           │           ├── QWidget#generalPage
 *           │           │     ├── QGroupBox#languageGroup
 *           │           │     ├── QGroupBox#startupGroup
 *           │           │     └── QGroupBox#closeBehaviorGroup
 *           │           ├── QWidget#serverPage
 *           │           │     ├── QGroupBox#serverNetworkGroup
 *           │           │     └── QGroupBox#serverAuthGroup
 *           │           └── QWidget#advancedPage
 *           │                 └── QGroupBox#loggingGroup
 *           │                       ├── QPushButton#presetDebugBtn
 *           │                       └── QPushButton#resetRulesBtn
 *           └── QWidget#buttonWidget
 *                 └── QPushButton#restoreDefaultsBtn
 * ─────────────────────────────────────────────────────────────── */

#sidebarWidget {
    background-color: #121212;               /* token: --color-bg-sidebar */
}

#mainContentWidget {
    background-color: #252525;               /* token: --color-bg-content */
    border-left: 1px solid #333333;          /* token: --color-border-sidebar */
}

#buttonWidget {
    background-color: #1E1E1E;               /* token: --color-bg-btnbar */
    border-top: 1px solid #333333;           /* token: --color-border-sidebar */
}

#generalPage,
#serverPage,
#advancedPage {
    background-color: transparent;
}

/* ── [settingsdialog.ui] 恢复默认值按钮 ── */
#restoreDefaultsBtn {
    background-color: #4A90D9;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 20px;                       /* token: --spacing-btn-py / --spacing-btn-px */
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 500;
    min-width: 100px;
    min-height: 32px;
}

/* ── [settingsdialog.ui] 日志页辅助按钮 ── */
#presetDebugBtn,
#resetRulesBtn {
    background-color: #3A3A3A;               /* token: --color-border-light */
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 5px 14px;
    font-size: 12px;                         /* token: --font-size-sm */
    font-weight: 400;                        /* token: --font-weight-normal */
    color: #CCCCCC;                          /* token: --color-text-btn-secondary */
}
#presetDebugBtn:hover,
#resetRulesBtn:hover {
    background-color: #444444;
    border-color: #666666;
}

/* ── [settingsdialog.ui] 开机自启复选框 ── */
#autoStartCheckBox {
    spacing: 8px;                            /* token: --spacing-sm */
}
#autoStartCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background-color: #2D2D2D;               /* token: --color-bg-dropdown */
    border: 2px solid #555555;               /* token: --color-border-strong */
}
#autoStartCheckBox::indicator:checked {
    background-color: #4A90D9;               /* token: --color-accent */
    border-color: #4A90D9;
}

/* ── [settingsdialog.ui] 日志规则文本框 ── */
#logRulesTextEdit {
    border: 1px solid #555555;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 12px;
    background-color: #2D2D2D;               /* token: --color-bg-dropdown */
    color: #E0E0E0;                          /* token: --color-text-primary */
    font-family: "Consolas", "Cascadia Code", "Courier New", monospace;
    font-size: 12px;                         /* token: --font-size-sm */
}
#logRulesTextEdit:focus {
    border-color: #4A90D9;                   /* token: --color-accent */
}
