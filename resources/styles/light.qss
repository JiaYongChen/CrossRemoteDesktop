/* ═══════════════════════════════════════════════════════════
 * CrossRemoteDesktop — 浅色主题 QSS
 *
 * 架构：三段式分层
 *   第一层：全局基础（系统级控件）
 *   第二层：类型默认样式（无父选择器限定）
 *   第三层：区域样式覆盖（按 .ui 文件分组，父→子→孙）
 *
 * 修改规范：见项目记忆 project_qss_layered_template
 * ═══════════════════════════════════════════════════════════
 *
 *  设计令牌 / Design Tokens
 * ═══════════════════════════════════════════════════════════
 *
 *  ① 基础色板
 *    --color-bg-page:          #F5F5F5    (QMainWindow)
 *    --color-bg-card:          #FFFFFF    (卡片/GroupBox)
 *    --color-bg-elevated:      #FCFCFC    (输入框)
 *    --color-bg-nav:           #E8E8E8    (左侧导航栏)
 *    --color-bg-nav-btn:       #E4E4E4    (导航按钮静态)
 *    --color-bg-header:        #F0F0F0    (品牌区)
 *    --color-bg-statusbar:     #F0F0F0    (状态栏)
 *    --color-bg-sidebar:       #F3F3F3    (设置侧栏)
 *    --color-bg-content:       #FCFCFC    (设置内容区)
 *    --color-bg-btnbar:        #F3F3F3    (设置按钮区)
 *    --color-bg-disabled:      #F0F0F0    (禁用态)
 *    --color-bg-tooltip:       #FFFFFF    (工具提示)
 *    --color-bg-dropdown:      #FFFFFF    (下拉列表)
 *    --color-bg-hamburger:     #DCDCDC    (汉堡菜单按钮)
 *
 *  ② 文字色
 *    --color-text-primary:     #1A1A1A    (正文)
 *    --color-text-secondary:   #666666    (标签/辅助)
 *    --color-text-muted:       #999999    (空状态/占位)
 *    --color-text-status:      #666666    (状态栏)
 *    --color-text-btn-secondary: #333333  (次要按钮文字)
 *    --color-text-on-accent:   #FFFFFF    (强调色上的文字)
 *
 *  ③ 强调色
 *    --color-accent:           #0078D4    (默认)
 *    --color-accent-hover:     #106EBE    (悬停)
 *    --color-accent-pressed:   #005A9E    (按下)
 *
 *  ④ 边框与分隔
 *    --color-border-default:   #D0D0D0    (输入框/菜单边框)
 *    --color-border-strong:    #CFCFCF    (SpinBox/ComboBox 边框)
 *    --color-border-light:     #E0E0E0    (卡片/GroupBox 边框)
 *    --color-border-subtle:    #E0E0E0    (状态栏顶部分隔)
 *    --color-border-sidebar:   #E5E5E5    (侧边栏分隔)
 *    --color-separator:        #CCCCCC    (侧边栏分隔线)
 *
 *  ⑤ 语义色
 *    --color-danger-hover:     #D32F2F    (退出按钮悬停)
 *
 *  ⑥ 悬停/按下态（控件通用）
 *    --color-hover-light:      #EBEBEB    (浅悬停)
 *    --color-hover-medium:     #E0E0E0    (中悬停)
 *    --color-hover-nav:        #CCCCCC    (导航按钮悬停)
 *    --color-pressed:          #D8D8D8    (按下)
 *    --color-pressed-nav:      #C0C0C0    (导航按钮按下)
 *
 *  ⑦ 圆角
 *    --radius-sm:              4px
 *    --radius-md:              6px
 *    --radius-lg:              8px
 *
 *  ⑧ 间距
 *    --spacing-xs:             4px
 *    --spacing-sm:             8px
 *    --spacing-md:             12px
 *    --spacing-input-px:       14px
 *    --spacing-input-py:       8px
 *    --spacing-btn-px:         20px
 *    --spacing-btn-py:         8px
 *
 *  ⑨ 字体
 *    --font-size-sm:           12px
 *    --font-size-md:           13px
 *    --font-size-lg:           14px
 *    --font-size-xl:           20px
 *    --font-weight-normal:     400
 *    --font-weight-bold:       600
 * ═══════════════════════════════════════════════════════════ */

/* ═══════════════════════ 第一层：全局基础 ═══════════════════════ */

QMainWindow {
    background-color: #F5F5F5;               /* token: --color-bg-page */
}

QDialog {
    background-color: #F5F5F5;               /* token: --color-bg-page */
    color: #1A1A1A;                          /* token: --color-text-primary */
}

/* ----- 工具提示 ----- */
QToolTip {
    background-color: #FFFFFF;               /* token: --color-bg-tooltip */
    color: #1A1A1A;                          /* token: --color-text-primary */
    border: 1px solid #CCCCCC;               /* token: --color-separator */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 4px 8px;
    font-size: 12px;                         /* token: --font-size-sm */
}

/* ----- 菜单 ----- */
QMenu {
    background-color: #FFFFFF;               /* token: --color-bg-dropdown */
    border: 1px solid #D0D0D0;               /* token: --color-border-default */
    border-radius: 6px;                      /* token: --radius-md */
    padding: 4px 0;
    color: #1A1A1A;                          /* token: --color-text-primary */
}
QMenu::item {
    padding: 6px 24px;
}
QMenu::item:selected {
    background-color: #0078D4;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
}
QMenu::separator {
    height: 1px;
    background: #E0E0E0;                     /* token: --color-border-light */
    margin: 4px 12px;
}

/* ----- 状态栏 ----- */
QStatusBar {
    background-color: #F0F0F0;               /* token: --color-bg-statusbar */
    color: #666666;                          /* token: --color-text-status */
    border-top: 1px solid #E0E0E0;           /* token: --color-border-subtle */
}
QStatusBar QLabel {
    color: #666666;                          /* token: --color-text-status */
    padding: 2px 8px;
    background: transparent;
}

/* ----- 全局滚动条（主窗口隐藏） ----- */
QScrollBar:vertical {
    width: 0px;
    background: transparent;
}
QScrollBar:horizontal {
    height: 0px;
    background: transparent;
}

/* ----- 文本选中色 ----- */
* {
    selection-background-color: #0078D4;     /* token: --color-accent */
}

/* ═══════════════════════ 第二层：类型默认样式 ═══════════════════════ */

/* ----- QLabel ----- */
QLabel {
    color: #1A1A1A;                          /* token: --color-text-primary */
    background: transparent;
}

/* ----- QLineEdit ----- */
QLineEdit {
    background-color: #FCFCFC;               /* token: --color-bg-elevated */
    color: #1A1A1A;                          /* token: --color-text-primary */
    border: 1px solid #D0D0D0;               /* token: --color-border-default */
    border-radius: 6px;                      /* token: --radius-md */
    padding: 8px 14px;                       /* token: --spacing-input-py / --spacing-input-px */
    selection-background-color: #0078D4;     /* token: --color-accent */
}
QLineEdit:focus {
    border-color: #0078D4;                   /* token: --color-accent */
}

/* ----- QComboBox ----- */
QComboBox {
    border: 1px solid #CFCFCF;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 5px 10px;
    background-color: #FFFFFF;               /* token: --color-bg-card */
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-size: 13px;                         /* token: --font-size-md */
}
QComboBox:hover {
    border-color: #999999;               /* hover border */
}
QComboBox:focus {
    border-color: #0078D4;                   /* token: --color-accent */
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    image: url(:/icons/dropdown-arrow.svg);
    width: 12px;
    height: 12px;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    border: 1px solid #CFCFCF;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    background-color: #FFFFFF;               /* token: --color-bg-dropdown */
    selection-background-color: rgba(0, 120, 212, 0.12);    /* token: --color-accent (12% alpha) */
    selection-color: #1A1A1A;                /* token: --color-text-primary */
    outline: none;
}

/* ----- QSpinBox ----- */
QSpinBox {
    border: 1px solid #CFCFCF;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 12px;
    background-color: #FFFFFF;               /* token: --color-bg-card */
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-size: 13px;                         /* token: --font-size-md */
}
QSpinBox:hover {
    border-color: #999999;               /* hover border */
}
QSpinBox:focus {
    border-color: #0078D4;                   /* token: --color-accent */
}
QSpinBox:disabled {
    background-color: #F0F0F0;               /* token: --color-bg-disabled */
    color: #A0A0A0;                          /* disabled text */
    border-color: #E0E0E0;                   /* token: --color-border-light */
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #CFCFCF;          /* token: --color-border-strong */
    border-bottom: 1px solid #CFCFCF;          /* token: --color-border-strong */
    border-top-right-radius: 4px;
}
QSpinBox::up-button:hover { background-color: #E8E8E8; }                                       /* token: --color-bg-nav */
QSpinBox::up-arrow {
    image: url(:/icons/spin-up.svg);
    width: 8px;
    height: 8px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #CFCFCF;          /* token: --color-border-strong */
    border-bottom-right-radius: 4px;
}
QSpinBox::down-button:hover { background-color: #E8E8E8; }                                       /* token: --color-bg-nav */
QSpinBox::down-arrow {
    image: url(:/icons/spin-down.svg);
    width: 8px;
    height: 8px;
}

/* ----- QPushButton ----- */
QPushButton {
    background-color: #0078D4;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 20px;                       /* token: --spacing-btn-py / --spacing-btn-px */
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 500;
    min-width: 90px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #106EBE;               /* token: --color-accent-hover */
}
QPushButton:pressed {
    background-color: #005A9E;               /* token: --color-accent-pressed */
}

/* ----- QDialogButtonBox ----- */
QDialogButtonBox QPushButton {
    background-color: #0078D4;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 6px 18px;
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 500;
    min-width: 90px;
    min-height: 28px;
}
QDialogButtonBox QPushButton:hover {
    background-color: #106EBE;               /* token: --color-accent-hover */
}
QDialogButtonBox QPushButton:pressed {
    background-color: #005A9E;               /* token: --color-accent-pressed */
}

/* ----- QCheckBox ----- */
QCheckBox {
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-size: 13px;                         /* token: --font-size-md */
    spacing: 8px;                            /* token: --spacing-sm */
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background-color: #FFFFFF;               /* token: --color-bg-card */
    border: 2px solid #CCCCCC;               /* token: --color-separator */
}
QCheckBox::indicator:checked {
    background-color: #0078D4;               /* token: --color-accent */
    border-color: #0078D4;
}
QCheckBox::indicator:hover {
    border-color: #999999;
}
QCheckBox::indicator:checked:hover {
    background-color: #106EBE;               /* token: --color-accent-hover */
    border-color: #106EBE;
}

/* ----- QGroupBox ----- */
QGroupBox {
    background-color: #FFFFFF;               /* token: --color-bg-card */
    border: 1px solid #E0E0E0;               /* token: --color-border-light */
    border-radius: 8px;                      /* token: --radius-lg */
    margin-top: 8px;
    padding: 18px 12px 12px 12px;
    font-weight: 600;                        /* token: --font-weight-bold */
    font-size: 13px;                         /* token: --font-size-md */
    color: #1A1A1A;                          /* token: --color-text-primary */
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #1A1A1A;                          /* token: --color-text-primary */
}

/* ----- QTabWidget / QTabBar ----- */
QTabWidget::pane {
    background-color: #FCFCFC;               /* token: --color-bg-elevated */
    border: none;
    border-top: 1px solid #E0E0E0;           /* token: --color-border-light */
    top: -1px;
    padding: 6px 28px;
}
QTabBar::tab {
    background-color: transparent;
    color: #666666;                          /* token: --color-text-secondary */
    padding: 10px 20px;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 400;                        /* token: --font-weight-normal */
}
QTabBar::tab:selected {
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-weight: 600;                        /* token: --font-weight-bold */
    border-bottom: 3px solid #0078D4;        /* token: --color-accent */
}
QTabBar::tab:hover:!selected {
    color: #333333;
}

/* ----- QListWidget ----- */
QListWidget {
    background-color: #F3F3F3;               /* token: --color-bg-sidebar */
    border: none;
    outline: none;
    font-size: 13px;                         /* token: --font-size-md */
    padding: 6px 4px;
}
QListWidget::item {
    padding: 9px 12px;
    margin: 1px 4px;
    border-radius: 6px;                      /* token: --radius-md */
    border-left: 3px solid transparent;
    color: #424242;
    font-weight: 400;                        /* token: --font-weight-normal */
}
QListWidget::item:selected {
    background-color: rgba(0, 0, 0, 0.06);
    border-left: 3px solid #0078D4;          /* token: --color-accent */
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-weight: 600;                        /* token: --font-weight-bold */
}
QListWidget::item:hover:!selected {
    background-color: rgba(0, 0, 0, 0.03);
}

/* ----- QSlider ----- */
QSlider::groove:horizontal {
    background-color: #E0E0E0;               /* token: --color-border-light */
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background-color: #0078D4;               /* token: --color-accent */
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #FFFFFF;               /* token: --color-bg-card */
    border: 2px solid #0078D4;               /* token: --color-accent */
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background-color: #F0F0F0;               /* token: --color-bg-disabled */
    border-color: #106EBE;                   /* token: --color-accent-hover */
}

/* ----- QTextEdit ----- */
QTextEdit {
    border: 1px solid #CFCFCF;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 12px;
    background-color: #FFFFFF;               /* token: --color-bg-card */
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-family: "Consolas", "Cascadia Code", "Courier New", monospace;
    font-size: 12px;                         /* token: --font-size-sm */
}
QTextEdit:focus {
    border-color: #0078D4;                   /* token: --color-accent */
}

/* ----- 对话框内滚动条（与主窗口隐藏滚动条区分） ----- */
QDialog QScrollBar:vertical {
    width: 6px;
    background-color: transparent;
    margin: 0;
}
QDialog QScrollBar::handle:vertical {
    background-color: #C0C0C0;
    border-radius: 3px;
    min-height: 30px;
}
QDialog QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}
QDialog QScrollBar::add-line:vertical,
QDialog QScrollBar::sub-line:vertical {
    height: 0px;
}
QDialog QScrollBar::add-page:vertical,
QDialog QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* ═══════════════════════ 第三层：区域样式覆盖 ═══════════════════════ */

/* ── [mainwindow.ui] 左侧导航栏 ────────────────────────────────
 * Widget 树:
 *   HamburgerMenu (custom widget)
 *     └── QWidget#leftNavBar
 *           ├── QToolButton (导航项 ×N)
 *           ├── QToolButton#hamburgerItem
 *           └── QToolButton#exitItem
 * ─────────────────────────────────────────────────────────────── */
#leftNavBar {
    background-color: #E8E8E8;               /* token: --color-bg-nav */
}

#leftNavBar > QToolButton {
    background-color: #E4E4E4;               /* token: --color-bg-nav-btn */
    border: none;
    border-radius: 8px;                      /* token: --radius-lg */
    padding: 4px;                            /* token: --spacing-xs */
}
#leftNavBar > QToolButton:hover {
    background-color: #CCCCCC;               /* token: --color-hover-nav */
}
#leftNavBar > QToolButton:pressed {
    background-color: #C0C0C0;               /* token: --color-pressed-nav */
}

#hamburgerItem {
    background-color: #DCDCDC;               /* token: --color-bg-hamburger */
    border: none;
    border-radius: 8px;                      /* token: --radius-lg */
    padding: 8px;                            /* token: --spacing-sm */
}
#hamburgerItem:hover {
    background-color: #D0D0D0;               /* token: --color-hover-medium */
}

#exitItem:hover {
    background-color: #D32F2F;               /* token: --color-danger-hover */
}

/* ── [mainwindow.ui] 侧边栏分隔线 ── */
#sideSeparator {
    background-color: #CCCCCC;               /* token: --color-separator */
}

/* ── [mainwindow.ui] 品牌区 ──
 * Widget 树:
 *   QWidget#headerArea
 *     └── QLabel#logoLabel
 *     └── QLabel#titleLabel
 * ─────────────────────────────────────────────────────────────── */
#headerArea {
    background-color: #F0F0F0;               /* token: --color-bg-header */
}

#titleLabel {
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-size: 20px;                         /* token: --font-size-xl */
    font-weight: bold;
    background: transparent;
}

/* ── [mainwindow.ui] 连接卡片区域 ──
 * Widget 树（ConnectionPanel 内部）:
 *   QFrame#connectionCard
 *     ├── QLabel#cardHostname
 *     ├── QLabel#cardLabel
 *     └── QToolButton (操作按钮)
 * ─────────────────────────────────────────────────────────────── */
#connectionCard {
    background-color: #FFFFFF;               /* token: --color-bg-card */
    border: 1px solid #E0E0E0;               /* token: --color-border-light */
    border-radius: 8px;                      /* token: --radius-lg */
}

#connectionCard QToolButton {
    background-color: #F0F0F0;               /* token: --color-hover-light */
    border: none;
    border-radius: 6px;                      /* token: --radius-md */
    padding: 4px;                            /* token: --spacing-xs */
}
#connectionCard QToolButton:hover {
    background-color: #E0E0E0;               /* token: --color-hover-medium */
}
#connectionCard QToolButton:pressed {
    background-color: #D0D0D0;               /* token: --color-pressed */
}

#cardHostname {
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-size: 14px;                         /* token: --font-size-lg */
    font-weight: bold;
    background: transparent;
}

#cardLabel {
    color: #666666;                          /* token: --color-text-secondary */
    font-size: 12px;                         /* token: --font-size-sm */
    background: transparent;
}

/* ── [mainwindow.ui] 搜索框 ── */
#searchBox {
    background-color: #FFFFFF;               /* token: --color-bg-card */
    color: #1A1A1A;                          /* token: --color-text-primary */
    border: 1px solid #D0D0D0;               /* token: --color-border-default */
    border-radius: 8px;                      /* token: --radius-lg */
    padding: 10px 16px;
    font-size: 14px;                         /* token: --font-size-lg */
}
#searchBox:focus {
    border-color: #0078D4;                   /* token: --color-accent */
}

/* ── [mainwindow.ui] 空状态 ── */
#emptyStateLabel {
    color: #999999;                          /* token: --color-text-muted */
    font-size: 13px;                         /* token: --font-size-md */
    background: transparent;
}

/* ── [ConnectionDialog.ui] 对话框容器 ── */
#ConnectionDialog {
    background-color: #F5F5F5;               /* token: --color-bg-page */
}

#tabContainer {
    background-color: transparent;
}

QStackedWidget#settingsStackedWidget {
    background-color: transparent;
}

#connectionTab,
#optionsTab,
#advancedTab {
    background-color: transparent;
}

/* ── [settingsdialog.ui] 设置对话框 ──
 * Widget 树:
 *   QDialog#SettingsDialog
 *     └── QWidget#contentWidget
 *           ├── QWidget#sidebarWidget
 *           │     └── QListWidget#categoryListWidget
 *           ├── QWidget#mainContentWidget
 *           │     └── QStackedWidget#settingsStackedWidget
 *           │           ├── QWidget#generalPage
 *           │           │     ├── QGroupBox#languageGroup
 *           │           │     ├── QGroupBox#startupGroup
 *           │           │     └── QGroupBox#closeBehaviorGroup
 *           │           ├── QWidget#serverPage
 *           │           │     ├── QGroupBox#serverNetworkGroup
 *           │           │     └── QGroupBox#serverAuthGroup
 *           │           └── QWidget#advancedPage
 *           │                 └── QGroupBox#loggingGroup
 *           │                       ├── QPushButton#presetDebugBtn
 *           │                       └── QPushButton#resetRulesBtn
 *           └── QWidget#buttonWidget
 *                 └── QPushButton#restoreDefaultsBtn
 * ─────────────────────────────────────────────────────────────── */

#sidebarWidget {
    background-color: #F3F3F3;               /* token: --color-bg-sidebar */
}

#mainContentWidget {
    background-color: #FCFCFC;               /* token: --color-bg-content */
    border-left: 1px solid #E5E5E5;          /* token: --color-border-sidebar */
}

#buttonWidget {
    background-color: #F3F3F3;               /* token: --color-bg-btnbar */
    border-top: 1px solid #E5E5E5;           /* token: --color-border-sidebar */
}

#generalPage,
#serverPage,
#advancedPage {
    background-color: transparent;
}

/* ── [settingsdialog.ui] 恢复默认值按钮 ── */
#restoreDefaultsBtn {
    background-color: #0078D4;               /* token: --color-accent */
    color: #FFFFFF;                          /* token: --color-text-on-accent */
    border: none;
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 20px;                       /* token: --spacing-btn-py / --spacing-btn-px */
    font-size: 13px;                         /* token: --font-size-md */
    font-weight: 500;
    min-width: 100px;
    min-height: 32px;
}

/* ── [settingsdialog.ui] 日志页辅助按钮 ── */
#presetDebugBtn,
#resetRulesBtn {
    background-color: #F5F5F5;
    border: 1px solid #D0D0D0;               /* token: --color-border-default */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 5px 14px;
    font-size: 12px;                         /* token: --font-size-sm */
    font-weight: 400;                        /* token: --font-weight-normal */
    color: #333333;                          /* token: --color-text-btn-secondary */
}
#presetDebugBtn:hover,
#resetRulesBtn:hover {
    background-color: #E8E8E8;
    border-color: #BCBCBC;
}

/* ── [settingsdialog.ui] 开机自启复选框 ── */
#autoStartCheckBox {
    spacing: 8px;                            /* token: --spacing-sm */
}
#autoStartCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background-color: #FFFFFF;               /* token: --color-bg-card */
    border: 2px solid #CCCCCC;               /* token: --color-separator */
}
#autoStartCheckBox::indicator:checked {
    background-color: #0078D4;               /* token: --color-accent */
    border-color: #0078D4;
}

/* ── [settingsdialog.ui] 日志规则文本框 ── */
#logRulesTextEdit {
    border: 1px solid #CFCFCF;               /* token: --color-border-strong */
    border-radius: 4px;                      /* token: --radius-sm */
    padding: 8px 12px;
    background-color: #FFFFFF;               /* token: --color-bg-card */
    color: #1A1A1A;                          /* token: --color-text-primary */
    font-family: "Consolas", "Cascadia Code", "Courier New", monospace;
    font-size: 12px;                         /* token: --font-size-sm */
}
#logRulesTextEdit:focus {
    border-color: #0078D4;                   /* token: --color-accent */
}
