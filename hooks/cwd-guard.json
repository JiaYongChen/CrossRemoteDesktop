{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "$root = 'D:/AICode/CrossRemoteDesktop'; $cwd = (Get-Location).Path.Replace('\\', '/').TrimEnd('/'); if ($cwd -ne $root) { Write-Output \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PostToolUse\\\",\\\"additionalContext\\\":\\\"[MANDATORY] CWD=$cwd != $root. Run: cd $root\\\"}}\" }",
            "shell": "powershell",
            "statusMessage": "cwd-root-guard: 检查工作目录是否偏离项目根目录"
          }
        ]
      }
    ]
  }
}
